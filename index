  <div id="project-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-uaPaper border border-uaLine rounded-3xl max-w-lg w-full p-8 relative shadow-2xl">
      <button onclick="closeProjectModal()" class="absolute top-6 right-6 w-8 h-8 rounded-full bg-uaCard border border-uaLine flex items-center justify-center text-uaMuted hover:text-uaInk">✕</button>
      <div class="font-mono text-xs text-uaTeal mb-2">UA REPOSITORY DETAILS</div>
      <h3 id="modal-title" class="font-serif text-3xl mb-4 text-uaInk">Project Title</h3>
      <p id="modal-desc" class="text-uaMuted text-sm leading-relaxed mb-6">Project description goes here...</p>
